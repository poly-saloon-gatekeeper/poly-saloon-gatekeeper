{
  "name": "poly-saloon-gatekeeper",
  "version": "1.0.0",
  "description": "Production-ready Discord onboarding, moderation, and community prompt bot for Poly Saloon.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "start:prod": "npm run prisma:deploy && npm run register && node src/index.js",
    "register": "node src/register-commands.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "node --check src/index.js && node --check src/register-commands.js",
    "test:phase1": "node --test test/phase1-onboarding.test.js",
    "test:phase2": "node --test test/phase2-moderation.test.js",
    "test:phase3": "node --test test/phase3-prompts.test.js",
    "test:bot-intro": "node --test test/bot-intro-dm.test.js",
    "test:monitoring": "node --test test/channel-monitoring.test.js",
    "test": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:bot-intro && npm run test:monitoring"
  },
  "keywords": [
    "discord",
    "discord.js",
    "poly-saloon",
    "onboarding",
    "moderation"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "ms": "^2.1.3",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
